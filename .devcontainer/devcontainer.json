{
  "name": "NCONPP Dev Environment",
  "build": {
    "dockerfile": "../Dockerfile",
    "target": "devcontainer"
  },
  "remoteUser": "developer",
  "runArgs": [
    "--userns=keep-id"
  ],
  "workspaceFolder": "/workspaces/nconpp",
  "mounts": [
    "source=nconpp-vcpkg-cache,target=/home/developer/.cache/vcpkg,type=volume"
  ],
  "postCreateCommand": "cmake --fresh --preset container-debug && ln -sf build/container-debug/compile_commands.json compile_commands.json"
}

{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "displayName": "Default Config",
            "description": "Default build using Ninja generator.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "environment": {
                "CC": "clang",
                "CXX": "clang++",
                "PYTHON_VENV": "${sourceDir}/.venv",
                "VCPKG_ROOT": "${sourceDir}/vcpkg"
            },
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/install/${presetName}",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "Python_EXECUTABLE": "${sourceDir}/.venv/bin/python"
            },
            "vendor": {
                "microsoft.com/VisualStudioSettings/CMake/1.0": {
                    "hostOS": [
                        "Linux"
                    ],
                    "clangTidyChecks": "llvm-include-order, -modernize-use-override",
                    "enableMicrosoftCodeAnalysis": true,
                    "enableClangTidyCodeAnalysis": true
                },
                "microsoft.com/VisualStudioRemoteSettings/CMake/1.0": {
                    "sourceDir": "$env{HOME}/.vs/$ms{projectDirName}"
                }
            }
        },
        {
            "name": "linux-debug",
            "displayName": "Linux Debug (Host)",
            "description": "Build on host system using build/linux-debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "container-debug",
            "displayName": "Container Debug (Devcontainer/CI)",
            "description": "Build inside container using build/container-debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "linux-python",
            "displayName": "Linux Python Bindings",
            "description": "Build Python bindings using build/linux-python",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Python"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "linux-debug",
            "configurePreset": "linux-debug"
        },
        {
            "name": "container-debug",
            "configurePreset": "container-debug"
        },
        {
            "name": "linux-python",
            "configurePreset": "linux-python"
        }
    ],
    "testPresets": [
        {
            "name": "linux-gtests-debug",
            "description": "User specified test preset running googletest on host.",
            "displayName": "googletest debug (host)",
            "configurePreset": "linux-debug"
        },
        {
            "name": "container-gtests-debug",
            "description": "User specified test preset running googletest in container.",
            "displayName": "googletest debug (container)",
            "configurePreset": "container-debug"
        }
    ]
}
